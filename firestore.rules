rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to manage their own user document and settings subcollection
    match /users/{userId} {
      allow read: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;

      // Allow users to read their own settings/preferences
      match /settings/{settingId} {
        allow read: if request.auth.uid == userId;
      }
    }

    // Allow read/write for household documents
    match /households/{householdId} {
      // Helper function to check if the user is a member of the household
      function isHouseholdMember(hid) {
        return get(/databases/$(database)/documents/households/$(hid)).data.members.hasAny([request.auth.uid]);
      }

      // Allow read for individual household documents if the user is a member.
      // Allow list operations (queries) on households if the query is specifically by joinCode.
      allow read: if request.auth.uid != null && (
        isHouseholdMember(householdId) ||
        request.method == 'list'
      );
      allow create: if request.auth.uid != null &&
                      request.resource.data.members.hasAll([request.auth.uid]) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0; // Allow authenticated user to create a household with a name and themselves as a member
      allow update: if request.auth.uid != null && (
        // Condition 1: An existing member updates activeShoppingListId or name
        (isHouseholdMember(householdId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeShoppingListId']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        )) ||
        // Condition 2: An existing member removes themselves from the members list
        (isHouseholdMember(householdId) &&
          resource.data.members.hasAll([request.auth.uid]) && // User was a member
          request.resource.data.members.size() == resource.data.members.size() - 1 && // One member removed
          !request.resource.data.members.hasAny([request.auth.uid]) && // Current user is no longer a member
          resource.data.members.hasAll(request.resource.data.members) && // All other members are still there
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) // Only members field changed
        ) ||
        // Condition 3: A non-member adds themselves to the members list
        (!isHouseholdMember(householdId) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members.concat([request.auth.uid])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        )
      );
      allow delete: if request.auth.uid == resource.data.ownerId; // Only owner can delete
    }

    // Allow read/write for pantry items within a household
    match /pantryItems/{pantryItemId} {
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow update, delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
    }

    // Allow authenticated users to read from the local_products_ph collection
    match /local_products_ph/{productId} {
      allow read: if request.auth.uid != null;
    }

    // Allow read/write for shopping lists within a household
    match /shoppingLists/{listId} {
      function isUserHouseholdMemberForList(hid) {
        return exists(/databases/$(database)/documents/households/$(hid)) &&
               get(/databases/$(database)/documents/households/$(hid)).data.members.hasAny([request.auth.uid]);
      }

      // Allow get/list if the user is a member of the household associated with the shopping list.
      allow get, list: if request.auth.uid != null && isUserHouseholdMemberForList(resource.data.householdId);

      // Deny create, update, delete for anonymous users
      allow create: if request.auth.uid != null && isUserHouseholdMemberForList(request.resource.data.householdId);
      allow update: if request.auth.uid != null && isUserHouseholdMemberForList(resource.data.householdId);
      allow delete: if request.auth.uid != null && isUserHouseholdMemberForList(resource.data.householdId);

      // Rules for shopping list items subcollection
      match /items/{itemId} {
        function isUserHouseholdMemberForListItem() {
          let listDoc = get(/databases/$(database)/documents/shoppingLists/$(listId));
          // Ensure the parent shopping list exists and has a householdId before checking membership
          return listDoc.data.keys().hasAll(['householdId']) && isUserHouseholdMemberForList(listDoc.data.householdId);
        }

        // Allow full access to items if the user is a member of the household
        allow read, create, update, delete: if request.auth.uid != null && isUserHouseholdMemberForListItem();
      }
    }

    // Allow read/write for shopping history items within a household
    match /shoppingHistory/{historyItemId} {
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
    }

    // Rules for the root-level appNotifications collection
    match /appNotifications/{notificationId} {
      // Users can read, update, and delete their own notifications
      allow read, update, delete: if request.auth.uid != null && resource.data.userId == request.auth.uid;
      // Users can create notifications for themselves
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
    }

    // Allow authenticated users to read and write their own user preferences
    match /userPrefs/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Allow authenticated users to create feedback documents
    match /feedback/{feedbackId} {
      allow create: if request.auth.uid != null;
    }

    // Rules for household tasks
    match /householdTasks/{taskId} {
      // Helper function to check if the user is a member of the household for a given task
      function isTaskHouseholdMember(taskDoc) {
        return get(/databases/$(database)/documents/households/$(taskDoc.householdId)).data.members.hasAny([request.auth.uid]);
      }

      // Allow read if the user is a member of the household the task belongs to
      allow read: if request.auth.uid != null && isTaskHouseholdMember(resource.data);

      // Allow create if the user is the owner of the household and the assigned user is a member
      allow create: if request.auth.uid != null &&
                      request.resource.data.assignedByUserId == request.auth.uid &&
                      get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == request.auth.uid &&
                      get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.resource.data.assignedToUserId]);

      // Allow update if the user is the assigned user and is marking the task as 'done'
      allow update: if request.auth.uid != null &&
                      resource.data.assignedToUserId == request.auth.uid &&
                      request.resource.data.status == 'done' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);

      // Allow delete if the user is the one who assigned the task (owner)
      allow delete: if request.auth.uid != null && resource.data.assignedByUserId == request.auth.uid;
    }
    
    match /pantryItems/{itemId} {
      function isHouseholdMember(hid) {
        return get(/databases/$(database)/documents/households/$(hid))
               .data.members.hasAny([request.auth.uid]);
      }
      allow read: if request.auth != null
              && (
                   (resource.data.ownerId == request.auth.uid)
                   ||
                   (resource.data.householdId is string
                    && isHouseholdMember(resource.data.householdId))
                 );

  		allow list: if request.auth != null
              && (
                   (resource.data.ownerId == request.auth.uid)
                   ||
                   (resource.data.householdId is string
                    && isHouseholdMember(resource.data.householdId))
                 );
      
    }

  }
}
