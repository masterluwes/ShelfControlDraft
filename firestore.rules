rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for authenticated users to their own user document
    match /users/{userId} {
      allow read: if request.auth.uid != null; // Allow any authenticated user to read user documents
      allow update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Allow read/write for household documents
    match /households/{householdId} {
      // Helper function to check if the user is a member of the household
      function isHouseholdMember(hid) {
        return get(/databases/$(database)/documents/households/$(hid)).data.members.hasAny([request.auth.uid]);
      }

      // Allow read for individual household documents if the user is a member.
      // Allow list operations (queries) on households if the query is specifically by joinCode.
      allow read: if request.auth.uid != null && (
        isHouseholdMember(householdId) ||
        (request.method == 'list' && request.query.isConstrainedBy('joinCode'))
      );
      allow create: if request.auth.uid != null &&
                      request.resource.data.members.hasAll([request.auth.uid]) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0; // Allow authenticated user to create a household with a name and themselves as a member
      allow update: if request.auth.uid != null && isHouseholdMember(householdId) && (
        (
          // Allow a user to add themselves to the members list (only 'members' field can change)
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members.concat([request.auth.uid])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        ) ||
        (
          // Allow a user to remove themselves from the members list (only 'members' field can change)
          resource.data.members.hasAll([request.auth.uid]) && // User was a member
          request.resource.data.members.size() == resource.data.members.size() - 1 && // One member removed
          !request.resource.data.members.hasAny([request.auth.uid]) && // Current user is no longer a member
          resource.data.members.hasAll(request.resource.data.members) && // All other members are still there
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) // Only members field changed
        ) ||
        (
          // Allow a household member to update the activeShoppingListId
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeShoppingListId'])
        ) ||
        (
          // Allow a household member to update the household name
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        )
      );
      allow delete: if request.auth.uid == resource.data.ownerId; // Only owner can delete
    }

    // Allow read/write for pantry items within a household
    match /pantryItems/{pantryItemId} {
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update, delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Allow authenticated users to read from the local_products_ph collection
    match /local_products_ph/{productId} {
      allow read: if request.auth.uid != null;
    }

    // Allow read/write for shopping lists within a household
    match /shoppingLists/{listId} {
      // Simplified read rule for queries: check if the user is a member of the household associated with the shopping list
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      // Deny create, update, delete for anonymous users
      allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';

      // Rules for shopping list items subcollection
      match /items/{itemId} {
        allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/shoppingLists/$(listId)).data.householdId)).data.members.hasAny([request.auth.uid]);
        // Deny create, update, delete for anonymous users
        allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/shoppingLists/$(listId)).data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
        allow update, delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/shoppingLists/$(listId)).data.householdId)).data.members.hasAny([request.auth.uid]) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // Allow read/write for shopping history items within a household
    match /shoppingHistory/{historyItemId} {
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.hasAny([request.auth.uid]);
      allow delete: if request.auth.uid != null && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.hasAny([request.auth.uid]);
    }

    // Allow read/write for notification settings field within the user document
    match /users/{userId} {
      allow update: if request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationSettings']);
      allow read: if request.auth.uid == userId;
    }

    // Rules for the root-level appNotifications collection
    match /appNotifications/{notificationId} {
      allow read: if request.auth.uid != null;
      // Deny create, update, delete for anonymous users
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update, delete: if request.auth.uid != null && resource.data.userId == request.auth.uid && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
